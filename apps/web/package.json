    "start:prod": "node ./server.js",
    "build:pwa": "cross-env NODE_ENV=production rspack build --config rspack.sw.ts && node scripts/inject-service-worker.mjs",
    "build:staging": "cross-env NODE_ENV=production ENV_TARGET=staging rspack build --config rspack.prod.ts && npm run build:pwa && gzipper compress --verbose ./build",
