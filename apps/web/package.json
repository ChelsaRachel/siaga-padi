    "build:prod.analyze": "cross-env NODE_ENV=production-analyze ENV_TARGET=production rspack build --config rspack.prod.ts && npm run build:pwa && gzipper compress --verbose ./build",
    "find-deadcode": "ts-prune",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
