# --- Agent management plane (mandatory router /agent-mgmt/*) ---
# be-python adalah service layer untuk workforce of agents (registry, runs, schedules,
# webhooks, DLQ). Routes /agent-mgmt/* gated via JWT admin OR X-Internal-Token header.
INTERNAL_API_TOKEN=replace_me_with_long_random_secret_for_internal_callers
BE_AGENTS_TICK_SECONDS=30

# MCPHub (used by agent_mgmt._fire_agent to call agents in project group)
MCP_HUB_URL=http://localhost:3001
MCP_HUB_API_KEY=replace_me
MCP_HUB_GROUP=replace_me_with_project_slug
